SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-rotated-service-role-key

# Optional for resumable uploads; derived automatically from SUPABASE_URL.
SUPABASE_STORAGE_UPLOAD_URL=https://your-project.storage.supabase.co/storage/v1/upload/resumable

